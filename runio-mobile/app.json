{
  "expo": {
    "name": "RACEON",
    "slug": "runio-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/runio-r-circle-green-v1.png",
    "scheme": "runio",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.raceon.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.runio.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/branding/runio-r-circle-green-v1.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/runio-r-circle-green-v1.png"
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/branding/runio-r-circle-green-v1.png",
          "imageWidth": 160
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RACEON uses your location to track a run's route and distance while the app is open."
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "RACEON uses your photo library so you can set a profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#00ff87"
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b28fdd4f-c624-4e91-8040-64efa2eb8d64"
      }
    },
    "owner": "harelbenezra"
  }
}
