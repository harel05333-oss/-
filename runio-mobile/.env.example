# Copy to .env. Defaults to the deployed production API on Vercel (stable,
# always on). For fast local backend iteration, point this at your machine's
# LAN IP instead (ipconfig / ifconfig), matching whatever `npm run dev`
# prints as the Network URL in v-racer — e.g. http://192.168.1.81:3000 — but
# note iOS ATS blocks plain http:// to a LAN address inside Expo Go.
EXPO_PUBLIC_API_URL=https://v-racer-one.vercel.app

# Google OAuth "Web application" client ID (public identifier, not a secret).
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
